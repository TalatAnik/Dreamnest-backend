// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  firstName   String
  lastName    String
  phone       String?
  avatar      String?
  role        UserRole @default(RENTER)
  isVerified  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  ownedProperties    Property[]   @relation("PropertyOwner")
  tenantProperties   Property[]   @relation("PropertyTenant")
  services          Service[]    @relation("ServiceProvider")
  leaseApplications LeaseApplication[] @relation("RenterApplications")
  serviceBookings   ServiceBooking[] @relation("ServiceBooker")
  reviews           Review[]     @relation("ReviewAuthor")
  receivedReviews   Review[]     @relation("ReviewTarget")
  notifications     Notification[]
  messages          Message[]     @relation("MessageSender")
  receivedMessages  Message[]     @relation("MessageReceiver")
  files             File[]

  @@map("users")
}

model Property {
  id              String        @id @default(cuid())
  title           String
  description     String
  address         String
  city            String
  state           String
  zipCode         String
  country         String        @default("Bangladesh")
  latitude        Float?
  longitude       Float?
  propertyType    PropertyType
  bedrooms        Int
  bathrooms       Int
  area            Float         // in square feet
  maxOccupants    Int?          // Maximum number of people who can live in the property
  monthlyRent     Float?        // Monthly rent in BDT
  securityDeposit Float         @default(0)  // One-time security deposit
  isActive        Boolean       @default(true)
  availableFrom   DateTime?     // When property becomes available for leasing
  amenities       String[]
  images          String[]
  rules           String[]
  
  // Lease Management
  leaseStatus     LeaseStatus   @default(VACANT)
  currentTenant   User?         @relation("PropertyTenant", fields: [currentTenantId], references: [id])
  currentTenantId String?
  leaseStartDate  DateTime?     // Current lease start date
  leaseEndDate    DateTime?     // Current lease end date
  nextRentDue     DateTime?     // Next rent due date
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relationships
  owner           User          @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId         String
  leaseApplications LeaseApplication[]
  reviews         Review[]      @relation("PropertyReviews")
  notifications   Notification[]

  @@map("properties")
}

model Service {
  id              String        @id @default(cuid())
  title           String
  description     String
  category        ServiceCategory
  price           Float
  duration        Int           // in minutes
  location        String
  serviceArea     String[]      // areas where service is provided
  isActive        Boolean       @default(true)
  images          String[]
  requirements    String[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relationships
  provider        User          @relation("ServiceProvider", fields: [providerId], references: [id], onDelete: Cascade)
  providerId      String
  bookings        ServiceBooking[]
  reviews         Review[]      @relation("ServiceReviews")

  @@map("services")
}

model LeaseApplication {
  id                String              @id @default(cuid())
  preferredMoveInDate DateTime
  leaseDuration     Int                 // in months
  monthlyIncome     Float               // applicant's monthly income
  employmentStatus  String
  previousAddress   String?
  emergencyContact  String
  emergencyPhone    String
  specialRequests   String?
  status            ApplicationStatus   @default(PENDING)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relationships
  applicant         User                @relation("RenterApplications", fields: [applicantId], references: [id], onDelete: Cascade)
  applicantId       String
  property          Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId        String
  notifications     Notification[]

  @@map("lease_applications")
}

model ServiceBooking {
  id              String        @id @default(cuid())
  scheduledDate   DateTime
  scheduledTime   String
  duration        Int           // in minutes
  totalAmount     Float
  status          BookingStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   String?
  paymentIntentId String?       // for mock payment tracking
  specialRequests String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relationships
  booker          User          @relation("ServiceBooker", fields: [bookerId], references: [id], onDelete: Cascade)
  bookerId        String
  service         Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId       String
  payment         Payment?

  @@map("service_bookings")
}

model Payment {
  id                String        @id @default(cuid())
  amount            Float
  currency          String        @default("USD")
  paymentMethod     String
  paymentIntentId   String        // mock payment ID
  status            PaymentStatus @default(PENDING)
  processedAt       DateTime?
  refundedAt        DateTime?
  refundAmount      Float?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relationships (for service bookings only - rent payments are handled separately)
  serviceBooking    ServiceBooking? @relation(fields: [serviceBookingId], references: [id], onDelete: Cascade)
  serviceBookingId  String?       @unique

  @@map("payments")
}

model Review {
  id            String      @id @default(cuid())
  rating        Int         // 1-5 stars
  comment       String?
  reviewType    ReviewType  // PROPERTY or SERVICE
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relationships
  author        User        @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId      String
  targetUser    User        @relation("ReviewTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetUserId  String
  property      Property?   @relation("PropertyReviews", fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId    String?
  service       Service?    @relation("ServiceReviews", fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId     String?

  @@map("reviews")
}

model Notification {
  id          String           @id @default(cuid())
  title       String
  message     String
  type        NotificationType
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  // Relationships
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  leaseApplication  LeaseApplication? @relation(fields: [leaseApplicationId], references: [id], onDelete: Cascade)
  leaseApplicationId String?
  property          Property?        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId        String?

  @@map("notifications")
}

model Message {
  id          String    @id @default(cuid())
  content     String
  isRead      Boolean   @default(false)
  messageType MessageType @default(DIRECT)
  createdAt   DateTime  @default(now())

  // Relationships
  sender      User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderId    String
  receiver    User      @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId  String

  // Optional context (for property/service related messages)
  propertyId  String?
  serviceId   String?

  @@map("messages")
}

model File {
  id           String     @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  url          String
  category     FileCategory
  uploadedBy   User       @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  uploadedById String
  createdAt    DateTime   @default(now())

  @@map("files")
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_resets")
}

// Enums
enum UserRole {
  RENTER
  OWNER
  SERVICE_PROVIDER
  ADMIN
}

enum PropertyType {
  APARTMENT
  HOUSE
  CONDO
  VILLA
  STUDIO
  LOFT
  TOWNHOUSE
}

enum LeaseStatus {
  VACANT
  OCCUPIED
  UNDER_APPLICATION
  MAINTENANCE
  UNAVAILABLE
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ServiceCategory {
  CLEANING
  MAINTENANCE
  SECURITY
  CONCIERGE
  TRANSPORTATION
  CATERING
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  IN_PROGRESS
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ReviewType {
  PROPERTY
  SERVICE
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_COMPLETED
  REVIEW_RECEIVED
  MESSAGE_RECEIVED
  PROPERTY_APPROVED
  SERVICE_APPROVED
  GENERAL
}

enum FileCategory {
  AVATAR
  PROPERTY
  PORTFOLIO
  DOCUMENT
}

enum MessageType {
  DIRECT
  PROPERTY_INQUIRY
  SERVICE_INQUIRY
  BOOKING_UPDATE
  SYSTEM
}